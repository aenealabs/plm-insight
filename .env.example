PI_DB_PATH=plm_insight.db

# Sign-in: demo (default) | oidc (Microsoft Entra ID or any OIDC provider)
PI_AUTH=demo
# PI_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# PI_OIDC_CLIENT_ID=
# PI_OIDC_CLIENT_SECRET=
# PI_SESSION_SECRET=
# PI_APPROVER_ROLE=PLMInsight.Approver          # data stewards
# PI_COMPLIANCE_ROLE=PLMInsight.TradeCompliance # export classification decisions

# AI reviews: "replay" (offline demo), "anthropic" (Claude API), or "foundry" (Claude on Microsoft Foundry)
PI_LLM_PROVIDER=replay
PI_MODEL=claude-opus-5-5
PI_RECORD=false

# Mission Control: links to the other apps; the shared token lets PLM Insight send
# prevention requests to Backlog Pilot's intake inbox (same value as BP_SUITE_TOKEN).
# PI_BACKLOG_URL=http://127.0.0.1:8000
# PI_LEADERSHIP_URL=http://127.0.0.1:8010
# PI_SUITE_TOKEN=
# PI_PUBLIC_URL=http://127.0.0.1:8020

# Mission Control launcher: the same value in every suite app. The app name in the app bar
# opens a menu of these apps. Adding an app = adding it here, in each app's settings.
# MISSION_CONTROL_APPS=Backlog Pilot=http://127.0.0.1:8000, Leadership Pilot=http://127.0.0.1:8010, PLM Insight=http://127.0.0.1:8020
